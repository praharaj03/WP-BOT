# Primary provider: Groq (recommended for fast, low-cost WhatsApp replies)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-20b

# Optional Gemini fallback/provider
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

PORT=3000
REPLY_DELAY_MS=4000
# Required if the Windows backend is reachable from the internet.
# Use a long random value. Never commit the real value.
CONTROL_TOKEN=YOUR_LONG_RANDOM_CONTROL_TOKEN
